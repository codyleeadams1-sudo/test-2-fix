      "com.example.quickmenu.QuickMenuClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  },
  "mixins": [
    "quickmenu.mixins.json"
  ]
}